{
  "name": "admin-dashboard-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"{app,components,constants,contexts,lib,locales,mocks,scripts}/**/*.{ts,tsx,js}\" \"*.{js,mjs,json,ts,mts}\" \".github/**/*.{yml,yaml}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "format": "prettier -w ."
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@hookform/resolvers": "5.5.7",
    "@reduxjs/toolkit": "2.12.0",
    "@tailwindcss/forms": "0.5.11",
    "@tanstack/react-table": "8.21.3",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-redux": "9.3.0",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "msw": "2.15.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
